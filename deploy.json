{
  "version": 3,
  "app": "crons",
  "container_port": 8080,
  "health_path": "/healthz",
  "data": {
    "mount": true,
    "read_only": true,
    "host_source": "/srv/openclaw/state/state",
    "container_path": "/data/openclaw-state"
  },
  "env": [
    {"name": "BASIC_AUTH_USER", "secret_ref": "basic_auth_user", "required": true},
    {"name": "BASIC_AUTH_PASSWORD", "secret_ref": "basic_auth_password", "required": true}
  ]
}
